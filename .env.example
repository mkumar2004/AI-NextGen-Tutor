# -----------------------------------------------------------------------------
# AI-NextGen-Tutor - Environment Variables Example
# Duplicate this file as `.env.local` or `.env` and fill in your own keys.
# -----------------------------------------------------------------------------

# Convex Database Configuration
# Obtain by running `npx convex dev` or from your Convex Dashboard (https://dashboard.convex.dev)
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Stack Auth Credentials (https://stack-auth.com)
NEXT_PUBLIC_STACK_PROJECT_ID=your_stack_project_id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=pck_your_publishable_client_key
STACK_SECRET_SERVER_KEY=ssk_your_secret_server_key

# Google Gemini API Key (Required for real-time voice coaching & feedback)
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter API Key (Optional / Fallback AI models)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# Groq API Key (Optional / Fast LLM inference)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# App & Repository URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GITHUB_URL=https://github.com/mkumar2004/AI-NextGen-Tutor

